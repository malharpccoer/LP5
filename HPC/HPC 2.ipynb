'''Parallel Bubble Sort'''
Code:
#include <stdio.h>
#include <stdlib.h>
#include <omp.h>
#include <time.h>

void swap(int *num1, int *num2) {
    int temp = *num1;
    *num1 = *num2;
    *num2 = temp;
}

int main() {
    int SIZE = 256;
    int A[SIZE];

    srand(time(NULL)); // Seed for random
    for (int i = 0; i < SIZE; i++) {
        A[i] = rand() % SIZE;
    }

    int N = SIZE;
    int i, j, first;
    double start, end;

    start = omp_get_wtime();

    for (i = 0; i < N - 1; i++) {
        first = i % 2;
        #pragma omp parallel for default(none) shared(A, first, N)
        for (j = first; j < N - 1; j++) {
            if (A[j] > A[j + 1]) {
                swap(&A[j], &A[j + 1]);
            }
        }
    }

    end = omp_get_wtime();

    printf("\nSorted array (Bubble Sort):\n");
    for (i = 0; i < N; i++) {
        printf("%d ", A[i]);
    }
    printf("\n-------------------------\nTime Parallel = %f seconds\n", (end - start));

    return 0;
}
#Run Commands:
gcc -fopenmp parallel_bubble_sort.c -o bubble (First this command)
./bubble (Then use this command)


'''Parallel Merge Sort'''
Code:
#include <stdio.h>
#include <stdlib.h>
#include <omp.h>

void merge(int a[], int i1, int j1, int i2, int j2) {
    int temp[1000];
    int i = i1, j = i2, k = 0;

    while (i <= j1 && j <= j2) {
        if (a[i] < a[j])
            temp[k++] = a[i++];
        else
            temp[k++] = a[j++];
    }

    while (i <= j1) temp[k++] = a[i++];
    while (j <= j2) temp[k++] = a[j++];

    for (i = i1, j = 0; i <= j2; i++, j++)
        a[i] = temp[j];
}

void mergesort(int a[], int i, int j) {
    int mid;
    if (i < j) {
        mid = (i + j) / 2;

        #pragma omp parallel sections
        {
            #pragma omp section
            mergesort(a, i, mid);

            #pragma omp section
            mergesort(a, mid + 1, j);
        }

        merge(a, i, mid, mid + 1, j);
    }
}

int main() {
    int *a, n, i;
    double start, end;

    
    printf("Enter total number of elements: ");
    scanf("%d", &n);

    a = (int *)malloc(n * sizeof(int));
    if (a == NULL) {
        printf("Memory allocation failed.\n");
        return 1;
    }

    printf("Enter elements:\n");
    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    start = omp_get_wtime();
    mergesort(a, 0, n - 1);
    end = omp_get_wtime();

    printf("\nSorted array (Merge Sort):\n");
    for (i = 0; i < n; i++) {
        printf("%d ", a[i]);
    }

    printf("\n-------------------------\nTime Parallel = %f seconds\n", (end - start));
    free(a);
    return 0;
}
#Run Commands:
gcc -fopenmp parallel_merge_sort.c -o merge
./merge
